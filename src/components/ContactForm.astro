---
import { siteData } from '../content/site-data';
---

<form
	class="space-y-4 md:space-y-5"
	action="https://formspree.io/f/YOUR_FORM_ID"
	method="POST"
	id="contact-form"
>
	<div>
		<label for="name" class="block text-sm font-medium text-charcoal mb-2">
			{siteData.contact.form.name}
		</label>
		<input
			type="text"
			id="name"
			name="name"
			required
			class="w-full px-3 py-2 md:px-4 md:py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-burgundy bg-white transition-all text-sm md:text-base"
			style="border: 1px solid #aaa6a0;"
			onfocus="this.style.borderColor='#6D2E46'"
			onblur="this.style.borderColor='#A19587'"
		/>
	</div>
	<div>
		<label for="phone" class="block text-sm font-medium text-charcoal mb-2">
			{siteData.contact.form.phone}
		</label>
		<input
			type="tel"
			id="phone"
			name="phone"
			class="w-full px-3 py-2 md:px-4 md:py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-burgundy bg-white transition-all text-sm md:text-base"
			style="border: 1px solid #aaa6a0;"
			onfocus="this.style.borderColor='#6D2E46'"
			onblur="this.style.borderColor='#A19587'"
		/>
	</div>
	<div>
		<label for="email" class="block text-sm font-medium text-charcoal mb-2">
			{siteData.contact.form.email}
		</label>
		<input
			type="email"
			id="email"
			name="email"
			required
			class="w-full px-3 py-2 md:px-4 md:py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-burgundy bg-white transition-all text-sm md:text-base"
			style="border: 1px solid #aaa6a0;"
			onfocus="this.style.borderColor='#6D2E46'"
			onblur="this.style.borderColor='#A19587'"
		/>
	</div>
	<div>
		<label for="message" class="block text-sm font-medium text-charcoal mb-2">
			{siteData.contact.form.message}
		</label>
		<textarea
			id="message"
			name="message"
			required
			rows="4"
			class="w-full px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-burgundy bg-white transition-all resize-none"
			style="border: 1px solid #aaa6a0;"
			onfocus="this.style.borderColor='#6D2E46'"
			onblur="this.style.borderColor='#A19587'"
		></textarea>
	</div>
	<button type="submit" class="btn-primary w-full">
		{siteData.contact.form.submit}
	</button>
	<div id="form-success" class="hidden mt-4 p-4 text-sage rounded-lg" style="background-color: rgba(170, 166, 160, 0.1); border: 1px solid #aaa6a0;">
		{siteData.contact.form.success}
	</div>
</form>

<script>
	const form = document.getElementById('contact-form');
	const successMessage = document.getElementById('form-success');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(form);
			
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: formData,
					headers: {
						Accept: 'application/json',
					},
				});

				if (response.ok) {
					form.reset();
					if (successMessage) {
						successMessage.classList.remove('hidden');
						setTimeout(() => {
							successMessage.classList.add('hidden');
						}, 5000);
					}
				}
			} catch (error) {
				console.error('Error submitting form:', error);
			}
		});
	}
</script>
