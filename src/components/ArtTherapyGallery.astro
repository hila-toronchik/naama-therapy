---
---

<div class="art-gallery" id="art-carousel" aria-label="גלריית תמונות המחשה של יצירה בחומרי אמנות">
	<div class="gallery-frame">
		<button type="button" class="gallery-nav gallery-prev" aria-label="קבוצת תמונות קודמת">
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
		</button>
		<div class="gallery-viewport">
			<div class="gallery-track"></div>
		</div>
		<button type="button" class="gallery-nav gallery-next" aria-label="קבוצת תמונות הבאה">
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
		</button>
	</div>
	<div class="gallery-dots" aria-label="בחירת קבוצת תמונות"></div>
	<p class="gallery-status sr-only" aria-live="polite"></p>

	<div class="gallery-lightbox" role="dialog" aria-modal="true" aria-label="תמונה מוגדלת" aria-hidden="true">
		<button type="button" class="lightbox-close" aria-label="סגירת התמונה">
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
		</button>
		<img class="lightbox-image" src="" alt="" />
	</div>
</div>

<style is:global>
	.art-gallery { width: 100%; }
	.gallery-frame { position: relative; }
	.gallery-viewport { overflow: hidden; border-radius: .75rem; direction: ltr; }
	.gallery-track { display: flex; transition: transform .4s ease; }
	.gallery-page { min-width: 100%; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; }
	.gallery-image-button { border: 0; padding: 0; background: transparent; border-radius: .55rem; overflow: hidden; aspect-ratio: 1; cursor: pointer; }
	.gallery-image-button:focus-visible { outline: 3px solid var(--burgundy); outline-offset: 3px; }
	.gallery-image-button img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
	.gallery-image-button:hover img { transform: scale(1.04); }
	.gallery-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 2.75rem; height: 2.75rem; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; background: rgba(109,46,70,.88); color: white; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 10px rgba(0,0,0,.2); }
	.gallery-nav svg { width: 1.1rem; height: 1.1rem; }
	.gallery-prev { left: .4rem; } .gallery-next { right: .4rem; }
	.gallery-nav:disabled { opacity: .35; cursor: default; }
	.gallery-nav:focus-visible { outline: 3px solid white; outline-offset: 2px; }
	.gallery-dots { display: flex; justify-content: center; gap: 0; margin-top: .35rem; direction: ltr; }
	.gallery-dot { position: relative; width: 2.75rem; height: 2.75rem; padding: 0; border: 0; background: transparent; }
	.gallery-dot::after { content: ''; position: absolute; left: 50%; top: 50%; width: .65rem; height: .65rem; transform: translate(-50%,-50%); border-radius: 999px; background: rgba(109,46,70,.25); transition: width .2s ease, background-color .2s ease; }
	.gallery-dot[aria-current="true"]::after { width: 1.6rem; background: var(--burgundy); }
	.gallery-dot:focus-visible { outline: 3px solid var(--burgundy); outline-offset: -5px; border-radius: 999px; }
	.gallery-lightbox { display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,.9); align-items: center; justify-content: center; padding: 2rem; }
	.gallery-lightbox.open { display: flex; }
	.lightbox-image { max-width: 92vw; max-height: 88vh; object-fit: contain; border-radius: .5rem; }
	.lightbox-close { position: absolute; top: 1.25rem; left: 1.25rem; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.5); background: rgba(255,255,255,.12); color: white; display: flex; align-items: center; justify-content: center; }
	.lightbox-close svg { width: 1.4rem; height: 1.4rem; }
	@media (prefers-reduced-motion: reduce) { .gallery-track, .gallery-image-button img { transition: none; } }
</style>

<script>
function initArtGallery() {
	const root = document.getElementById('art-carousel');
	if (!root || root.dataset.ready) return;
	root.dataset.ready = 'true';
	const track = root.querySelector('.gallery-track');
	const dots = root.querySelector('.gallery-dots');
	const status = root.querySelector('.gallery-status');
	const prev = root.querySelector('.gallery-prev');
	const next = root.querySelector('.gallery-next');
	const lightbox = root.querySelector('.gallery-lightbox');
	const lightboxImage = root.querySelector('.lightbox-image');
	const closeButton = root.querySelector('.lightbox-close');
	if (!(track instanceof HTMLElement) || !(dots instanceof HTMLElement)) return;
	let page = 0;
	let pageCount = 0;
	let lastTrigger = null;

	const showPage = (nextPage) => {
		page = Math.max(0, Math.min(nextPage, pageCount - 1));
		track.style.transform = `translateX(-${page * 100}%)`;
		dots.querySelectorAll('button').forEach((dot, index) => dot.setAttribute('aria-current', String(index === page)));
		if (prev instanceof HTMLButtonElement) prev.disabled = page === 0;
		if (next instanceof HTMLButtonElement) next.disabled = page === pageCount - 1;
		if (status) status.textContent = `קבוצת תמונות ${page + 1} מתוך ${pageCount}`;
	};

	const closeLightbox = () => {
		if (!(lightbox instanceof HTMLElement)) return;
		lightbox.classList.remove('open');
		lightbox.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
	};

	fetch('/api/gallery-images.json').then(response => response.json()).then((images) => {
		if (!Array.isArray(images) || !images.length) return;
		pageCount = Math.ceil(images.length / 4);
		for (let p = 0; p < pageCount; p++) {
			const pageElement = document.createElement('div');
			pageElement.className = 'gallery-page';
			images.slice(p * 4, p * 4 + 4).forEach((src, index) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'gallery-image-button';
				const img = document.createElement('img');
				img.src = src;
				img.alt = `תמונת המחשה של יצירה בחומרי אמנות ${p * 4 + index + 1}`;
				img.loading = 'lazy';
				img.decoding = 'async';
				button.appendChild(img);
				button.addEventListener('click', () => {
					if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) return;
					lastTrigger = button;
					lightboxImage.src = src;
					lightboxImage.alt = img.alt;
					lightbox.classList.add('open');
					lightbox.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
					if (closeButton instanceof HTMLElement) closeButton.focus();
				});
				pageElement.appendChild(button);
			});
			track.appendChild(pageElement);
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className = 'gallery-dot';
			dot.setAttribute('aria-label', `הצגת קבוצת תמונות ${p + 1}`);
			dot.addEventListener('click', () => showPage(p));
			dots.appendChild(dot);
		}
		showPage(0);
	}).catch(() => { if (status) status.textContent = 'לא ניתן לטעון את התמונות'; });

	prev?.addEventListener('click', () => showPage(page - 1));
	next?.addEventListener('click', () => showPage(page + 1));
	root.addEventListener('keydown', (event) => {
		if (lightbox?.classList.contains('open')) {
			if (event.key === 'Escape') closeLightbox();
			if (event.key === 'Tab') { event.preventDefault(); if (closeButton instanceof HTMLElement) closeButton.focus(); }
			return;
		}
		if (event.key === 'ArrowLeft') showPage(page + 1);
		if (event.key === 'ArrowRight') showPage(page - 1);
	});
	closeButton?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initArtGallery);
else initArtGallery();
</script>
