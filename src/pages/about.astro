---
import Layout from '../components/Layout.astro';
import { siteData } from '../content/site-data';
---

<Layout title="אודות" description="אודות נעמה טירן - מטפלת באמנות ו-EMDR">
	<section class="py-6 md:py-8 bg-cream-warm min-h-[85vh]">
		<div class="container-custom w-full">
			<div class="max-w-6xl mx-auto">
				<!-- Header Section -->
				<div class="text-center mb-8 md:mb-12">
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-3 md:mb-4">
						{siteData.about.title}
					</h1>
					<div class="w-16 md:w-24 h-1 bg-burgundy mx-auto rounded-full"></div>
				</div>

				<!-- מי אני -->
				<div class="mb-8 md:mb-12">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4 md:mb-5">
						{siteData.about.whoAmI.title}
					</h2>
					<p class="text-base md:text-lg text-charcoal leading-relaxed max-w-4xl">
						{siteData.about.whoAmI.text}
					</p>
				</div>

				<!-- תמונה + הפילוסופיה הטיפולית + הניסיון הקליני -->
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 md:gap-6 mb-6 md:mb-8">
					<!-- Photo Section -->
					<div class="lg:col-span-1">
						<div class="relative">
							<div class="absolute -inset-2 md:-inset-4 bg-sage bg-opacity-20 rounded-2xl md:rounded-3xl transform rotate-2"></div>
							<img
								src="/images/naama.jpg"
								alt="נעמה טירן - מטפלת באמנות ו-EMDR"
								width="1066"
								height="1600"
								loading="lazy"
								decoding="async"
								class="relative rounded-xl md:rounded-2xl shadow-2xl w-full object-cover"
								style="aspect-ratio: 3/4;"
							/>
						</div>
					</div>
					
					<!-- הפילוסופיה הטיפולית + הניסיון הקליני -->
					<div class="lg:col-span-2 space-y-5 md:space-y-6">
						<!-- הפילוסופיה הטיפולית -->
						<div class="card-sage p-5 md:p-6">
							<h2 class="text-xl md:text-2xl font-display text-charcoal mb-4">
								{siteData.about.philosophy.title}
							</h2>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								{siteData.about.philosophy.text}
							</p>
						</div>
						
						<!-- הניסיון הקליני -->
						<div class="card-sage p-5 md:p-6">
							<h2 class="text-xl md:text-2xl font-display text-charcoal mb-4">
								{siteData.about.clinicalExperience.title}
							</h2>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								{siteData.about.clinicalExperience.text}
							</p>
						</div>
					</div>
				</div>

				<!-- הגישה הייחודית - 3 עמודות -->
				<div class="mb-6 md:mb-8">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4 md:mb-6 text-center">
						{siteData.about.uniqueApproach.title}
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
						{siteData.about.uniqueApproach.items.map((item, index) => (
							<div class="card-sage p-4 md:p-5">
								<h3 class="text-lg md:text-xl font-display text-charcoal mb-3">
									{item.title}
								</h3>
								<p class="text-sm md:text-base text-charcoal leading-relaxed">
									{item.text}
								</p>
							</div>
						))}
					</div>
				</div>

				<!-- הכשרה אקדמית ומקצועית -->
				<div class="mb-6 md:mb-8">
					<div class="card-sage p-5 md:p-6">
						<h2 class="text-xl md:text-2xl font-display text-charcoal mb-4">
							{siteData.about.education.title}
						</h2>
						<div class="space-y-3 md:space-y-4">
							{siteData.about.education.items.map((item) => (
								<div class="flex items-start gap-2 md:gap-3">
									<span class="text-burgundy text-lg md:text-xl mt-1 flex-shrink-0">•</span>
									<p class="text-base md:text-lg text-charcoal leading-relaxed">{item}</p>
								</div>
							))}
						</div>
					</div>
				</div>

			<!-- מיקום הטיפול -->
			<div class="card-sage p-5 md:p-6 mb-6 md:mb-8">
				<h2 class="text-xl md:text-2xl font-display text-charcoal mb-4">
					מיקום הטיפול
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-center">
					<!-- תמונת חדר הטיפול -->
					<div class="order-2 md:order-1">
						<img
							src="/images/therapy-room.webp"
							alt="חדר הטיפול של נעמה טירן - מושב רמות השבים"
							width="1125"
							height="1299"
							loading="lazy"
							decoding="async"
							class="w-full h-auto rounded-lg shadow-md object-cover"
						/>
					</div>
					
					<!-- מידע ולינק -->
					<div class="order-1 md:order-2">
						<p class="text-base md:text-lg text-charcoal leading-relaxed mb-3">
							{siteData.location.name}
						</p>
						<div class="flex flex-col gap-2">
							<a
								href={siteData.location.googleMapsUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-burgundy hover:underline text-base md:text-lg transition-colors inline-flex items-center gap-2"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
								פתח ב-Google Maps
							</a>
							<a
								href={siteData.location.wazeUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-burgundy hover:underline text-base md:text-lg transition-colors inline-flex items-center gap-2"
							>
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
									<path d="M11.436 2.127C6.27 2.127 2.073 6.324 2.073 11.49c0 2.485.973 4.745 2.558 6.426l-.717 2.25a.476.476 0 00.707.544l2.265-1.408c1.638.877 3.507 1.376 5.5 1.376 5.166 0 9.363-4.197 9.363-9.363 0-5.166-4.197-9.363-9.363-9.363m3.145 6.37c.39 0 .705.316.705.705 0 .39-.316.706-.705.706s-.706-.316-.706-.706.316-.705.706-.705m-6.29 0c.39 0 .706.316.706.705 0 .39-.316.706-.706.706s-.705-.316-.705-.706.316-.705.705-.705m8.583 5.07c-.744 1.807-2.558 3.07-4.67 3.07-2.112 0-3.926-1.263-4.67-3.07a.476.476 0 01.88-.364c.602 1.459 2.067 2.485 3.79 2.485s3.188-1.026 3.79-2.485a.476.476 0 01.88.364"/>
								</svg>
								נווט בווייז
							</a>
						</div>
					</div>
				</div>
			</div>

				<!-- Call to Action Section -->
				<div class="card-sage text-center p-5 md:p-6">
					<h2 class="text-2xl md:text-3xl font-display text-charcoal mb-3 md:mb-4">רוצים לבדוק התאמה?</h2>
					<p class="text-base md:text-lg text-charcoal mb-5 md:mb-6 max-w-2xl mx-auto">
						אם תרצו לבדוק אם הדרך הזו יכולה להתאים לכם, אפשר לכתוב לי ולקבוע שיחת היכרות קצרה ללא עלות.
					</p>
					<div class="flex flex-col items-center gap-3">
						<a
							href={`https://wa.me/${siteData.whatsapp}`}
							target="_blank"
							rel="noopener noreferrer"
							class="bg-burgundy text-white hover:opacity-90 inline-flex items-center gap-2 text-base md:text-lg px-6 py-3 rounded-lg transition-opacity"
						>
							<svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
							</svg>
							צור קשר ב-WhatsApp
						</a>
						<a
							href={siteData.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="bg-burgundy text-white hover:opacity-90 inline-flex items-center gap-2 text-base md:text-lg px-6 py-3 rounded-lg transition-opacity"
						>
							<svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
							</svg>
							צור קשר באינסטגרם
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
