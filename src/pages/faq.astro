---
import Layout from '../components/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { siteData } from '../content/site-data';
---

<Layout title="שאלות נפוצות על טיפול רגשי | נעמה טירן" description="תשובות לשאלות על תחילת טיפול רגשי למבוגרים, שיחת ההיכרות, EMDR, טיפול באמנות וטיפול מקוון אצל נעמה טירן.">
	<section class="py-10 md:py-14 bg-cream-warm">
		<div class="container-custom">
			<div class="max-w-5xl mx-auto">
				<header class="scroll-reveal fade-up text-center mb-8 md:mb-10">
					<h1 class="text-3xl md:text-4xl font-display text-burgundy mb-4">
						{siteData.faq.title}
					</h1>
					<p class="reading-width text-base md:text-lg text-charcoal leading-relaxed">
						מידע על תחילת הטיפול, דרכי העבודה וההתאמה לתהליך.
					</p>
				</header>
				
				<div class="max-w-4xl mx-auto">
					<FAQAccordion items={siteData.faq.items} />
				</div>

				<div class="scroll-reveal fade-up text-center mt-9 md:mt-12">
					<p class="cta-width text-base md:text-lg text-charcoal leading-relaxed mb-5">
						אם נשארה שאלה, אפשר לפנות ולבדוק יחד אם הטיפול יכול להתאים.
					</p>
					<a href="/contact" class="btn-primary inline-flex items-center justify-center">
						לפרטים על שיחת ההיכרות
					</a>
				</div>
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": siteData.faq.items.map(item => ({
			"@type": "Question",
			"name": item.question,
			"acceptedAnswer": {
				"@type": "Answer",
				"text": item.answer
			}
		}))
	})} />
</Layout>
