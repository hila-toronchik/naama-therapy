---
import { siteData } from '../content/site-data';
---

<div>
	<div class="text-center mb-4 md:mb-6">
		<h2 class="text-2xl md:text-3xl font-display text-sage mb-3">
			מה אני מציעה
		</h2>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
		{siteData.features.map((feature, index) => (
			<div class={`card animate-stagger-${index + 1} p-6 md:p-8`}>
				<h3 class="text-xl md:text-2xl font-display text-sage mb-3">
					{feature.title}
				</h3>
				<p class="text-base md:text-lg text-charcoal leading-relaxed">
					{feature.description}
				</p>
			</div>
		))}
	</div>
</div>
