---
import { siteData } from '../content/site-data';
import { articleCategories } from '../content/article-categories';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => currentPath === path;
const isServicesActive = ['/services', '/emdr', '/art-therapy'].includes(currentPath);
const isArticlesActive = currentPath === '/articles' || currentPath.startsWith('/articles/');
const linkClass = (active: boolean) => `text-charcoal hover:text-burgundy transition-colors font-medium ${active ? 'text-burgundy underline decoration-burgundy/40 underline-offset-8' : ''}`;
---

<nav class="bg-white shadow-md sticky top-0 z-50">
	<div class="container-custom">
		<div class="flex items-center justify-between h-16">
		<!-- Logo/Brand -->
		<a href="/" class="flex items-center gap-2 md:gap-3 text-xl md:text-2xl font-display text-sage hover:text-burgundy transition-colors">
			<img src="/logo.png" alt="לוגו נעמה טירן" width="48" height="48" decoding="async" class="h-11 md:h-12 w-auto" />
			<span>נעמה טירן - מטפלת רגשית</span>
		</a>

			<!-- Desktop Navigation -->
			<div class="hidden md:flex items-center gap-4 lg:gap-6">
				<a href="/" class={linkClass(isActive('/'))} aria-current={isActive('/') ? 'page' : undefined}>
					{siteData.nav.home}
				</a>
				<a href="/about" class={linkClass(isActive('/about'))} aria-current={isActive('/about') ? 'page' : undefined}>
					{siteData.nav.about}
				</a>
			<details class="relative group nav-dropdown">
				<summary class={`${linkClass(isServicesActive)} inline-flex items-center gap-1 cursor-pointer list-none`}>
					{siteData.nav.services}
					<svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
					</svg>
				</summary>
				<div class="absolute top-full right-0 mt-2 w-48 bg-white shadow-lg rounded-lg z-50">
					<div class="py-2">
							<a href="/services" class:list={['block px-4 py-2 hover:bg-cream-warm hover:text-burgundy transition-colors', isActive('/services') ? 'text-burgundy bg-cream-warm/60' : 'text-charcoal']} aria-current={isActive('/services') ? 'page' : undefined}>
								{siteData.nav.services}
							</a>
							<a href="/emdr" class:list={['block px-4 py-2 hover:bg-cream-warm hover:text-burgundy transition-colors', isActive('/emdr') ? 'text-burgundy bg-cream-warm/60' : 'text-charcoal']} aria-current={isActive('/emdr') ? 'page' : undefined}>
								{siteData.nav.emdr}
							</a>
							<a href="/art-therapy" class:list={['block px-4 py-2 hover:bg-cream-warm hover:text-burgundy transition-colors', isActive('/art-therapy') ? 'text-burgundy bg-cream-warm/60' : 'text-charcoal']} aria-current={isActive('/art-therapy') ? 'page' : undefined}>
								{siteData.nav.artTherapy}
							</a>
						</div>
					</div>
			</details>
				<details class="relative group nav-dropdown">
					<summary class={`${linkClass(isArticlesActive)} inline-flex items-center gap-1 cursor-pointer list-none`}>
						{siteData.nav.articles}
						<svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
						</svg>
					</summary>
					<div class="absolute top-full right-0 mt-2 w-80 bg-white shadow-lg rounded-lg z-50">
						<div class="py-2">
							<a href="/articles" class:list={['block px-4 py-2 hover:bg-cream-warm hover:text-burgundy transition-colors', isActive('/articles') ? 'text-burgundy bg-cream-warm/60' : 'text-charcoal']} aria-current={isActive('/articles') ? 'page' : undefined}>
								כל המאמרים
							</a>
							{articleCategories.map((category) => {
								const path = `/articles/category/${category.slug}`;
								return <a href={`${path}/`} class:list={['block px-4 py-2 text-sm hover:bg-cream-warm hover:text-burgundy transition-colors', isActive(path) ? 'text-burgundy bg-cream-warm/60' : 'text-charcoal']} aria-current={isActive(path) ? 'page' : undefined}>{category.name}</a>;
							})}
						</div>
					</div>
				</details>
				<a href="/faq" class={linkClass(isActive('/faq'))} aria-current={isActive('/faq') ? 'page' : undefined}>
					{siteData.nav.faq}
				</a>
				<a href="/contact" class={`btn-primary ${isActive('/contact') ? 'ring-2 ring-burgundy/30 ring-offset-2' : ''}`} aria-current={isActive('/contact') ? 'page' : undefined}>
					{siteData.nav.contact}
				</a>
			</div>

			<!-- Mobile Menu Button -->
			<button
				id="mobile-menu-button"
				class="md:hidden p-2 text-charcoal hover:text-burgundy transition-colors"
				aria-label="תפריט"
			>
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>

			<!-- Mobile Menu -->
			<div id="mobile-menu" class="hidden md:hidden pb-4">
				<div class="flex flex-col gap-4 mt-4">
					<a href="/" class={`${linkClass(isActive('/'))} py-2`} aria-current={isActive('/') ? 'page' : undefined}>
						{siteData.nav.home}
					</a>
					<a href="/about" class={`${linkClass(isActive('/about'))} py-2`} aria-current={isActive('/about') ? 'page' : undefined}>
						{siteData.nav.about}
					</a>
					<details class="group">
						<summary class={`${linkClass(isServicesActive)} py-2 inline-flex items-center gap-1 cursor-pointer list-none`}>
							{siteData.nav.services}
							<svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
						</summary>
						<div class="flex flex-col gap-2 mt-1">
							<a href="/services" class={`${linkClass(isActive('/services'))} py-1 pr-4`} aria-current={isActive('/services') ? 'page' : undefined}>→ כל תחומי הטיפול</a>
							<a href="/emdr" class={`${linkClass(isActive('/emdr'))} py-1 pr-4`} aria-current={isActive('/emdr') ? 'page' : undefined}>→ {siteData.nav.emdr}</a>
							<a href="/art-therapy" class={`${linkClass(isActive('/art-therapy'))} py-1 pr-4`} aria-current={isActive('/art-therapy') ? 'page' : undefined}>→ {siteData.nav.artTherapy}</a>
						</div>
					</details>
					<details class="group">
						<summary class={`${linkClass(isArticlesActive)} py-2 inline-flex items-center gap-1 cursor-pointer list-none`}>
							{siteData.nav.articles}
							<svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
						</summary>
						<div class="flex flex-col gap-2 mt-1">
							<a href="/articles" class={`${linkClass(isActive('/articles'))} py-1 pr-4`} aria-current={isActive('/articles') ? 'page' : undefined}>→ כל המאמרים</a>
							{articleCategories.map((category) => {
								const path = `/articles/category/${category.slug}`;
								return <a href={`${path}/`} class={`${linkClass(isActive(path))} py-1 pr-4 text-sm`} aria-current={isActive(path) ? 'page' : undefined}>→ {category.name}</a>;
							})}
						</div>
					</details>
					<a href="/faq" class={`${linkClass(isActive('/faq'))} py-2`} aria-current={isActive('/faq') ? 'page' : undefined}>
						{siteData.nav.faq}
					</a>
					<a href="/contact" class={`btn-primary text-center ${isActive('/contact') ? 'ring-2 ring-burgundy/30 ring-offset-2' : ''}`} aria-current={isActive('/contact') ? 'page' : undefined}>
						{siteData.nav.contact}
					</a>
				</div>
			</div>
	</div>
</nav>

<script>
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');

	if (menuButton && mobileMenu) {
		menuButton.setAttribute('aria-expanded', 'false');
		menuButton.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
			const isOpen = !mobileMenu.classList.contains('hidden');
			menuButton.setAttribute('aria-expanded', String(isOpen));
			if (!isOpen) {
				mobileMenu.querySelectorAll('details').forEach((detail) => detail.removeAttribute('open'));
			}
		});
	}

	const dropdowns = Array.from(document.querySelectorAll('nav details'));
	dropdowns.forEach((dropdown) => {
		dropdown.addEventListener('toggle', () => {
			if (dropdown.open) {
				dropdowns.forEach((otherDropdown) => {
					if (otherDropdown !== dropdown) otherDropdown.removeAttribute('open');
				});
			}
		});
	});
</script>

<style>
	summary::-webkit-details-marker { display: none; }
</style>
