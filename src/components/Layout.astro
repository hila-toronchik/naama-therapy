---
import '../styles/global.css';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import ScrollHint from './ScrollHint.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const { title, description = 'טיפול רגשי למבוגרים אצל נעמה טירן', ogImage, noindex = false } = Astro.props;
const siteName = 'נעמה טירן';
const fullTitle = title;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const siteURL = Astro.site?.href || 'https://naamatiran.com/';
const ogImageURL = ogImage || new URL('/og-image-naama-horizontal.png', siteURL).href;
const logoURL = Astro.site ? new URL('/logo.png', Astro.site).href : '/logo.png';
const portraitURL = new URL('/og-image-naama.jpg', siteURL).href;
const websiteId = new URL('/#website', siteURL).href;
const personId = new URL('/#naama-tiran', siteURL).href;
const practiceId = new URL('/#practice', siteURL).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite', '@id': websiteId, url: siteURL, name: siteName,
			alternateName: 'נעמה טירן – טיפול רגשי למבוגרים', inLanguage: 'he-IL',
			publisher: { '@id': practiceId }
		},
		{
			'@type': 'Person', '@id': personId, name: 'נעמה טירן',
			jobTitle: 'מטפלת באמנות וב־EMDR', url: siteURL, image: portraitURL,
			worksFor: { '@id': practiceId }, sameAs: ['https://www.instagram.com/naama_tiran']
		},
		{
			'@type': 'ProfessionalService', '@id': practiceId,
			name: 'נעמה טירן – טיפול רגשי למבוגרים', url: siteURL,
			description: 'טיפול רגשי למבוגרים בגישה אינטגרטיבית בקליניקה ברמות השבים, ליד רעננה.',
			logo: logoURL, image: ogImageURL, telephone: '+972-54-730-0780', email: 'naatiran@gmail.com',
			founder: { '@id': personId },
			address: { '@type': 'PostalAddress', addressLocality: 'רמות השבים', addressRegion: 'השרון', addressCountry: 'IL' },
			areaServed: ['רמות השבים', 'רעננה', 'כפר סבא', 'הוד השרון', 'הרצליה', 'נתניה', 'השרון'].map(name => ({ '@type': 'Place', name })),
			hasOfferCatalog: {
				'@type': 'OfferCatalog', name: 'שירותי טיפול רגשי למבוגרים',
				itemListElement: ['טיפול רגשי למבוגרים', 'טיפול EMDR', 'טיפול באמנות'].map(name => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } }))
			},
			sameAs: ['https://www.instagram.com/naama_tiran']
		}
	]
};
---

<!doctype html>
<html lang="he" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="נעמה טירן - מטפלת באמנות ו-EMDR" />
		<meta property="og:locale" content="he_IL" />
		<meta property="og:site_name" content={siteName} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL} />
		<meta property="twitter:image:alt" content={siteName} />
		
		<!-- Additional SEO -->
		<meta name="author" content="נעמה טירן" />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />
		
		<title>{fullTitle}</title>
		
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<Navigation />
		<main>
			<slot />
		</main>
		<Footer />
		<WhatsAppButton />
		<ScrollHint />
		
		<!-- Scroll Reveal Animation Script -->
		<script src="../scripts/scroll-reveal.js"></script>
	</body>
</html>
