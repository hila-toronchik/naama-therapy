---
const measurementId = 'G-JGRKVF4FWG';
---

<aside
	id="analytics-consent"
	class="analytics-consent hidden"
	role="dialog"
	aria-describedby="analytics-consent-description"
	aria-label="בחירת העדפות מדידה"
>
	<p id="analytics-consent-description" class="analytics-consent__text">
		אנחנו משתמשים בעוגיות למדידה בסיסית, כדי להבין את השימוש באתר ולשפר אותו.
		<a href="/privacy/">מדיניות הפרטיות</a>
	</p>
	<div class="analytics-consent__actions">
		<button id="analytics-consent-accept" type="button" class="analytics-consent__accept">לאשר</button>
		<button id="analytics-consent-decline" type="button" class="analytics-consent__decline">לא תודה</button>
	</div>
</aside>

<script define:vars={{ measurementId }}>
	const consentKey = 'naama-analytics-consent';
	const banner = document.getElementById('analytics-consent');
	const acceptButton = document.getElementById('analytics-consent-accept');
	const declineButton = document.getElementById('analytics-consent-decline');
	const settingsButton = document.getElementById('analytics-settings-button');

	const loadAnalytics = () => {
		if (document.getElementById('google-analytics-script')) return;

		window.dataLayer = window.dataLayer || [];
		window.gtag = function gtag(){ window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', measurementId, { anonymize_ip: true });

		const script = document.createElement('script');
		script.id = 'google-analytics-script';
		script.async = true;
		script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
		document.head.appendChild(script);
	};

	const saveChoice = (choice) => {
		try { localStorage.setItem(consentKey, choice); } catch {}
		banner?.classList.add('hidden');
	};

	let savedChoice = null;
	try { savedChoice = localStorage.getItem(consentKey); } catch {}

	if (savedChoice === 'granted') {
		loadAnalytics();
	} else if (savedChoice !== 'denied') {
		banner?.classList.remove('hidden');
	}

	acceptButton?.addEventListener('click', () => {
		saveChoice('granted');
		loadAnalytics();
	});

	declineButton?.addEventListener('click', () => saveChoice('denied'));
	settingsButton?.addEventListener('click', () => banner?.classList.remove('hidden'));

	const reportedScrollDepths = new Set();
	const reportScrollDepth = () => {
		if (!window.gtag) return;
		const available = document.documentElement.scrollHeight - window.innerHeight;
		if (available <= 0) return;
		const depth = Math.round((window.scrollY / available) * 100);
		[50, 90].forEach((threshold) => {
			if (depth >= threshold && !reportedScrollDepths.has(threshold)) {
				reportedScrollDepths.add(threshold);
				window.gtag('event', 'scroll_depth', { percent_scrolled: threshold, page_path: window.location.pathname });
			}
		});
	};
	window.addEventListener('scroll', reportScrollDepth, { passive: true });

	document.addEventListener('click', (event) => {
		if (!window.gtag) return;
		const link = event.target instanceof Element ? event.target.closest('a') : null;
		if (!link) return;
		const href = link.getAttribute('href') || '';
		let eventName = '';
		if (href.includes('wa.me/')) eventName = 'contact_whatsapp';
		else if (href.startsWith('tel:')) eventName = 'contact_phone';
		else if (href.startsWith('mailto:')) eventName = 'contact_email';
		else if (href.includes('instagram.com/')) eventName = 'social_instagram';
		else if (href.includes('facebook.com/')) eventName = 'social_facebook';
		if (eventName) window.gtag('event', eventName, { page_path: window.location.pathname });
	});
</script>

<style>
	.analytics-consent {
		position: fixed;
		right: 0.75rem;
		left: 0.75rem;
		bottom: 9.25rem;
		z-index: 70;
		max-width: 35rem;
		margin-inline: auto;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(109, 46, 70, 0.12);
		border-radius: 1.1rem;
		background: rgba(255, 253, 248, 0.98);
		box-shadow: 0 10px 30px rgba(73, 48, 58, 0.14);
		backdrop-filter: blur(10px);
	}
	.analytics-consent.hidden { display: none; }

	.analytics-consent__text {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--charcoal);
		text-align: center;
	}

	.analytics-consent__text a {
		color: var(--burgundy);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2rem;
		white-space: nowrap;
	}

	.analytics-consent__actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.65rem;
	}

	.analytics-consent__accept {
		min-width: 7.25rem;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		background: var(--burgundy);
		color: white;
		font-weight: 700;
		box-shadow: 0 5px 14px rgba(109, 46, 70, 0.2);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.analytics-consent__accept:hover { opacity: 0.92; transform: translateY(-1px); }

	.analytics-consent__decline {
		padding: 0.55rem 0.2rem;
		color: var(--charcoal);
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 0.2rem;
	}

	@media (min-width: 768px) {
		.analytics-consent {
			right: 1rem;
			left: 1rem;
			bottom: 1.5rem;
			width: min(52rem, calc(100vw - 2rem));
			max-width: 52rem;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 1.25rem;
			padding: 0.85rem 1.15rem;
		}
		.analytics-consent__text { text-align: right; }
		.analytics-consent__actions { margin-top: 0; flex-shrink: 0; }
	}
</style>
