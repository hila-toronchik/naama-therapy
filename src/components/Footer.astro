---
import { siteData } from '../content/site-data';
---

<footer class="bg-gray-900 text-white section-padding">
	<div class="container-custom">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-6 md:mb-8">
			<div>
				<h3 class="text-2xl font-display mb-4 text-white">נעמה טירן</h3>
				<p class="text-white">
					טיפול מקצועי באמנות ו-EMDR למבוגרים
				</p>
			</div>
			<div>
				<h4 class="font-semibold mb-4 text-white">קישורים מהירים</h4>
				<ul class="space-y-2 text-white">
					<li><a href="/" class="hover:text-cream-warm transition-colors">{siteData.nav.home}</a></li>
					<li><a href="/about" class="hover:text-cream-warm transition-colors">{siteData.nav.about}</a></li>
					<li><a href="/services" class="hover:text-cream-warm transition-colors">{siteData.nav.services}</a></li>
					<li><a href="/articles" class="hover:text-cream-warm transition-colors">{siteData.nav.articles}</a></li>
					<li><a href="/faq" class="hover:text-cream-warm transition-colors">{siteData.nav.faq}</a></li>
					<li><a href="/contact" class="hover:text-cream-warm transition-colors">{siteData.nav.contact}</a></li>
				</ul>
			</div>
			<div>
				<h4 class="font-semibold mb-4 text-white">צור קשר</h4>
				<ul class="space-y-2 text-white">
					<li>
						<a href={`https://wa.me/${siteData.whatsapp}`} class="hover:text-cream-warm transition-colors" target="_blank" rel="noopener noreferrer">
							WhatsApp: {siteData.phone}
						</a>
					</li>
					<li>
						<a href={`mailto:${siteData.email}`} class="hover:text-cream-warm transition-colors">
							{siteData.email}
						</a>
					</li>
				<li>
					<a href={siteData.instagram} class="hover:text-cream-warm transition-colors inline-flex items-center gap-1" target="_blank" rel="noopener noreferrer">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
						אינסטגרם
					</a>
				</li>
				<li>
					<a href={siteData.facebook} class="hover:text-cream-warm transition-colors inline-flex items-center gap-1" target="_blank" rel="noopener noreferrer">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M22 12a10 10 0 10-11.563 9.875v-6.988H7.898V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.887h-2.33v6.988A10.002 10.002 0 0022 12z"/>
						</svg>
						פייסבוק
					</a>
				</li>
				<li>
					<a href={siteData.location.googleMapsUrl} class="hover:text-cream-warm transition-colors inline-flex items-center gap-1" target="_blank" rel="noopener noreferrer">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
						</svg>
						Google Maps - {siteData.location.name}
					</a>
				</li>
				<li>
					<a href={siteData.location.wazeUrl} class="hover:text-cream-warm transition-colors inline-flex items-center gap-1" target="_blank" rel="noopener noreferrer">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M11.436 2.127C6.27 2.127 2.073 6.324 2.073 11.49c0 2.485.973 4.745 2.558 6.426l-.717 2.25a.476.476 0 00.707.544l2.265-1.408c1.638.877 3.507 1.376 5.5 1.376 5.166 0 9.363-4.197 9.363-9.363 0-5.166-4.197-9.363-9.363-9.363m3.145 6.37c.39 0 .705.316.705.705 0 .39-.316.706-.705.706s-.706-.316-.706-.706.316-.705.706-.705m-6.29 0c.39 0 .706.316.706.705 0 .39-.316.706-.706.706s-.705-.316-.705-.706.316-.705.705-.705m8.583 5.07c-.744 1.807-2.558 3.07-4.67 3.07-2.112 0-3.926-1.263-4.67-3.07a.476.476 0 01.88-.364c.602 1.459 2.067 2.485 3.79 2.485s3.188-1.026 3.79-2.485a.476.476 0 01.88.364"/>
						</svg>
						Waze - {siteData.location.name}
					</a>
				</li>
				</ul>
			</div>
		</div>
		<div class="border-t border-white border-opacity-20 pt-6 md:pt-8 text-center text-white">
			<p>&copy; {new Date().getFullYear()} נעמה טירן. כל הזכויות שמורות.</p>
			<div class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
				<a href="/privacy/" class="hover:text-cream-warm transition-colors">מדיניות פרטיות</a>
			</div>
		</div>
	</div>
</footer>
