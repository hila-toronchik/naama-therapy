---
import { siteData } from '../content/site-data';
---

<section class="relative overflow-hidden bg-gradient-warm py-8 md:pt-12 md:pb-20">
	<div class="hero-text-glow" aria-hidden="true"></div>
	<div class="hero-image-glow" aria-hidden="true"></div>
	<div class="container-custom w-full">
		<div class="grid grid-cols-1 md:grid-cols-[46%_54%] items-center gap-7 md:gap-10">
			<div class="relative z-10 px-2 md:px-4">
				<h1 class="scroll-reveal fade-up text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-5 text-right">
					{siteData.hero.title}
				</h1>

				<div class="text-base md:text-lg text-charcoal leading-relaxed text-right">
					<p class="scroll-reveal fade-up delay-100 hero-hook">
						כש־<strong class="brush-highlight brush-rose">חוויות מהעבר</strong>, <strong class="brush-highlight brush-sage">דפוסים חוזרים</strong><br class="hidden lg:block" />
						או תחושות של <strong class="brush-highlight brush-gold">חרדה והצפה</strong> ממשיכים להשפיע על ההווה,<br class="hidden lg:block" />
						לפעמים קשה להבין מדוע זה קורה ואיך אפשר לנוע אחרת.
					</p>
					<p class="scroll-reveal fade-up delay-200 mt-5 hero-response">
						טיפול יכול להציע מקום <strong class="response-highlight">לעצור, להבין מה קורה בפנים</strong><br class="hidden lg:block" /> וליצור בהדרגה
						<strong class="response-highlight">אפשרויות חדשות</strong>.
					</p>
				</div>

				<p class="scroll-reveal fade-up delay-300 mt-5 text-base md:text-lg text-charcoal text-right">
					טיפול במושב <strong>רמות השבים</strong> (ליד רעננה)
				</p>

				<div class="scroll-reveal fade-up delay-300 mt-6 text-right">
					<a
						href={`https://wa.me/${siteData.whatsapp}`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn-primary inline-flex items-center gap-2 text-base md:text-lg shadow-lg hover:shadow-xl transition-shadow"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
						</svg>
						{siteData.hero.cta}
					</a>
				</div>
			</div>

			<div class="relative z-10 scroll-reveal scale-in bg-cream-warm rounded-2xl p-1.5 md:p-2 shadow-xl overflow-hidden w-full max-w-[440px] lg:max-w-[500px] mx-auto">
				<picture>
					<source media="(max-width: 767px)" srcset="/images/emdr-illustration-reversed-720.webp" />
					<img
						src="/images/emdr-illustration-reversed-1200.webp"
						alt="EMDR - מעבר ממחשבות שליליות לחיוביות, טיפול ב-EMDR"
						width="1200"
						height="1200"
						fetchpriority="high"
						decoding="async"
						class="w-full h-auto rounded-xl shadow-lg object-contain"
					/>
				</picture>
			</div>
		</div>
	</div>

	<a
		id="home-scroll-hint"
		href="#home-next-section"
		class="scroll-hint fixed bottom-5 left-1/2 z-40 hidden md:flex w-11 h-11 items-center justify-center rounded-full border border-burgundy/30 bg-cream-warm/90 text-burgundy shadow-md backdrop-blur-sm transition-[opacity,background-color] duration-300 hover:bg-cream-warm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy"
		aria-label="לגלילה לתוכן הבא"
	>
		<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
		</svg>
	</a>
</section>

<script>
	const scrollHint = document.getElementById('home-scroll-hint');

	if (scrollHint) {
		const updateScrollHint = () => {
			scrollHint.classList.toggle('is-hidden', window.scrollY > 80);
		};

		updateScrollHint();
		window.addEventListener('scroll', updateScrollHint, { passive: true });
	}
</script>

<style>
	.hero-text-glow,
	.hero-image-glow {
		position: absolute;
		pointer-events: none;
		filter: blur(2px);
	}

	.hero-text-glow {
		inset: 4% 48% 8% 2%;
		background: radial-gradient(ellipse at center, rgba(255, 253, 248, 0.94) 0%, rgba(255, 253, 248, 0.42) 58%, transparent 78%);
	}

	.hero-image-glow {
		width: 42rem;
		height: 42rem;
		left: -9rem;
		top: -10rem;
		border-radius: 44% 56% 63% 37% / 48% 42% 58% 52%;
		background: rgba(212, 224, 199, 0.24);
		transform: rotate(-9deg);
	}

	.hero-hook,
	.hero-response {
		max-width: 36rem;
	}

	.brush-highlight {
		position: relative;
		display: inline;
		z-index: 0;
		font-weight: 700;
		white-space: nowrap;
	}

	.brush-highlight::before {
		content: '';
		position: absolute;
		z-index: -1;
		right: -0.18em;
		left: -0.18em;
		bottom: 0.03em;
		height: 0.64em;
		border-radius: 58% 42% 55% 45% / 72% 58% 42% 28%;
		transform: rotate(-1.2deg) scaleX(0);
		transform-origin: right center;
		animation: brush-reveal 650ms ease-out forwards;
	}

	.brush-rose::before { background: rgba(224, 177, 170, 0.42); animation-delay: 350ms; }
	.brush-sage::before { background: rgba(166, 187, 146, 0.38); animation-delay: 520ms; }
	.brush-gold::before { background: rgba(224, 194, 135, 0.40); animation-delay: 690ms; }

	.response-highlight {
		color: #743247;
		font-weight: 800;
	}

	@keyframes brush-reveal {
		to { transform: rotate(-1.2deg) scaleX(1); }
	}

	@media (max-width: 767px) {
		.hero-text-glow {
			inset: 0 -15% 48% -15%;
		}

		.hero-image-glow {
			width: 28rem;
			height: 28rem;
			left: -11rem;
			top: 48%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brush-highlight::before {
			animation: none;
			transform: rotate(-1.2deg) scaleX(1);
		}
	}
</style>
