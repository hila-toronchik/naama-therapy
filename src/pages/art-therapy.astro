---
import Layout from '../components/Layout.astro';
import { siteData } from '../content/site-data';
import ArtTherapyGallery from '../components/ArtTherapyGallery.astro';
---

<Layout title="טיפול באמנות" description="מידע על טיפול באמנות למבוגרים: כיצד ניתן לשלב יצירה וחומרי אמנות בטיפול רגשי, למי האפשרות עשויה להתאים ומה קורה בתהליך.">
	<section class="py-10 md:py-14 bg-cream-warm">
		<div class="container-custom w-full">
			<div class="max-w-5xl mx-auto">
				<!-- Header -->
				<div class="scroll-reveal fade-up text-center mb-8 md:mb-12">
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-3 md:mb-4">
						מהו טיפול באמנות?
					</h1>
					<div class="w-16 md:w-24 h-1 bg-burgundy mx-auto rounded-full"></div>
				</div>

				<!-- מהו טיפול באמנות - ריבוע ראשי -->
				<div class="scroll-reveal fade-up card-sage p-5 md:p-6 mb-6 md:mb-8">
					<p class="reading-width text-base md:text-lg text-charcoal leading-relaxed">
						טיפול באמנות הוא טיפול רגשי המאפשר לשלב בתהליך יצירה, דימויים וחומרי אמנות. לעיתים העבודה החזותית או החומרית מציעה דרך נוספת לבטא, לחוש ולהתבונן בחוויות שקשה עדיין לנסח במילים. אין צורך בניסיון או בכישרון, והשימוש באמנות אינו חובה — אפשר בהחלט להגיע לטיפול המבוסס על שיחה בלבד.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-6 md:gap-8 mb-6 md:mb-8 items-stretch">
				<!-- איך זה עובד -->
				<div class="scroll-reveal fade-up card p-5 md:p-6 h-full">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4 md:mb-5 font-bold">
						איך זה עובד?
					</h2>
					
					<div class="space-y-4 md:space-y-5">
						<div>
							<p class="text-base md:text-lg text-charcoal leading-relaxed mb-4">
								בתהליך הטיפולי היצירה יכולה לאפשר ביטוי לדברים שקשה עדיין לומר במילים. אפשר להתבונן בה, לדבר דרכה או פשוט להיות איתה, בלי צורך להבין מיד מה היא אומרת.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								מתן ביטוי מוחשי לרגש
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לעיתים אנחנו מנסים להבין את החוויה באמצעות הסברים ומילים, אך הם אינם מצליחים לבטא את כולה. צבע, קו, צורה או חומר יכולים לפתוח ערוץ נוסף לביטוי ולאפשר מגע עם מה שעדיין קשה לומר — בלי לוותר על השיחה ובלי לחפש משמעות אחת נכונה.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								התבוננות מהצד
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								כאשר רגש או חוויה מקבלים צורה מוחשית, לפעמים מתאפשר להתבונן בהם ממרחק מסוים. ההתבוננות המשותפת עשויה לעזור לזהות מה עולה, לתת לו מילים ולבחון בהדרגה את הקשר שלנו אליו.
							</p>
						</div>
					</div>
				</div>

				<!-- גלריית המחשה -->
				<div class="scroll-reveal fade-up delay-100 card-sage p-5 md:p-6 h-full">
					<h2 class="card-heading text-2xl md:text-3xl font-display text-burgundy mb-2 font-bold">חומרים ויצירה</h2>
					<p class="text-sm md:text-base text-charcoal leading-relaxed mb-4">התמונות מוצגות להמחשה בלבד ואינן עבודות של מטופלים.</p>
					<ArtTherapyGallery />
				</div>
				</div>

				<!-- למי הטיפול מיועד -->
				<div class="scroll-reveal fade-up bg-[#fffaf3] rounded-xl border border-charcoal/10 p-5 md:p-6 mb-6 md:mb-8 md:grid md:grid-cols-[240px_1fr] md:gap-7 md:items-center">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4 md:mb-0 font-bold">
						למי הטיפול מיועד?
					</h2>
					<p class="text-base md:text-lg text-charcoal leading-relaxed">
						טיפול באמנות עשוי להתאים למבוגרים שמרגישים שלפעמים המילים אינן מספיקות, או שרוצים לבחון דרך נוספת לביטוי ולהתבוננות. ניתן לשלב אותו בעבודה עם טראומה, חרדה, קשיי ויסות, משברי חיים והתמכרויות, בהתאם לצרכים ולהתאמה האישית. אין צורך בכישרון או בניסיון באמנות, וההחלטה אם וכיצד לשלב יצירה נעשית יחד ובהדרגה.
					</p>
				</div>

				<!-- מה קורה בתוך חדר הטיפול -->
				<div class="scroll-reveal fade-up card p-5 md:p-6 mb-6 md:mb-8">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4 md:mb-5 font-bold">
						מה קורה בתוך חדר הטיפול?
					</h2>
					<p class="text-base md:text-lg text-charcoal leading-relaxed mb-6">
						בחדר הטיפול אין ציפייה ליצור תוצר יפה, מוצלח או מובן. אם בוחרים לעבוד עם חומרי אמנות, אפשר להתנסות, לעצור, לשנות כיוון או לבחור שלא להמשיך. ההתבוננות במה שנוצר נעשית יחד, בסקרנות וללא ניסיון לקבוע לו פירוש אחד נכון.
					</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								1. הזמנה ליצירה
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לא בכל פגישה נעשה שימוש באמנות. כאשר עולה אפשרות לשלב יצירה, נבדוק יחד אם היא מרגישה מתאימה ונבחר חומרים בהתאם למה שנוח ובטוח באותו רגע.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								2. תהליך היצירה
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								במהלך היצירה אני נמצאת לצדך וקשובה למה שעולה. אפשר ליצור בשקט, לדבר תוך כדי, לעצור או לשנות כיוון, בהתאם למה שמרגיש נכון באותו רגע.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								3. שיח והתבוננות
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לאחר היצירה אפשר להתבונן יחד במה שנוצר. לא ננסה "לפענח" את העבודה או להכתיב לה משמעות, אלא לבדוק אילו רגשות, מחשבות או אסוציאציות היא מעוררת וכיצד הם מתקשרים לחוויה האישית.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								4. צידה לדרך
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לפעמים היצירה מובילה לתובנה או לדרך מעשית לוויסות, ולפעמים היא משאירה שאלה שנמשיך לפגוש בהמשך. אין צורך להגיע לתוצאה מסוימת בכל פגישה.
							</p>
						</div>
					</div>
				</div>

				<div class="scroll-reveal fade-up text-center card-sage p-5 md:p-7">
					<p class="text-base md:text-lg text-charcoal leading-relaxed max-w-2xl mx-auto mb-5">אין צורך לדעת מראש אם תרצה או תרצי לשלב אמנות בטיפול. אפשר להתחיל בשיחה ולבדוק יחד אילו דרכי עבודה מרגישות מתאימות.</p>
					<a href="/contact" class="btn-primary inline-flex items-center justify-center mb-5">לפרטים על שיחת ההיכרות</a>
					<div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
						<a href="/services" class="text-burgundy hover:text-burgundy/80 transition-colors font-medium">← חזרה לתחומי טיפול</a>
						<a href="/faq" class="text-burgundy hover:text-burgundy/80 transition-colors font-medium">לשאלות נפוצות ←</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
