---
import Layout from '../components/Layout.astro';
import { siteData } from '../content/site-data';
---

<Layout title="SE וטיפול המשלב גוף ומערכת עצבים | נעמה טירן" description="מידע על שילוב עקרונות Somatic Experiencing בטיפול רגשי: תשומת לב לגוף, למערכת העצבים, למשאבים ולקצב האישי.">
	<section class="py-10 md:py-14 bg-gradient-warm">
		<div class="container-custom"><div class="max-w-5xl mx-auto">
			<header class="scroll-reveal fade-up text-center max-w-3xl mx-auto mb-10">
				<p class="text-sm md:text-base font-semibold text-burgundy/75 mb-2">אחת מדרכי העבודה האפשריות</p>
				<h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-5">Somatic Experiencing‏ (SE)</h1>
				<p class="text-lg md:text-xl leading-relaxed">גישה המתייחסת לקשר שבין חוויות רגשיות, תחושות הגוף ותגובות מערכת העצבים.</p>
			</header>
			<div class="grid md:grid-cols-2 gap-5 md:gap-7 mb-10">
				<section class="scroll-reveal fade-up card p-6 md:p-8"><h2 class="text-2xl md:text-3xl text-burgundy mb-4">למה להתייחס לגוף?</h2><p class="text-base md:text-lg leading-relaxed">לעיתים הגוף ממשיך להגיב גם כשאנחנו מבינים בשכל שהסכנה חלפה. דריכות, קיפאון, הצפה או ניתוק יכולים להיות חלק מהאופן שבו מערכת העצבים מנסה להגן עלינו. תשומת לב עדינה לתגובות האלה יכולה להרחיב את ההבנה של מה שקורה ולהוסיף אפשרויות בתוך הטיפול.</p></section>
				<section class="scroll-reveal fade-up delay-100 card-sage p-6 md:p-8"><h2 class="text-2xl md:text-3xl text-burgundy mb-4">איך נראית העבודה?</h2><p class="text-base md:text-lg leading-relaxed">העבודה נעשית בהדרגה ובקצב מותאם. אפשר לשים לב לתחושות, לתנועה, לנשימה, לדחפים ולמשאבים שעוזרים להרגיש יציבות. אין צורך לבצע תרגיל מסוים, ואפשר לעצור או לחזור לשיחה בכל שלב.</p></section>
			</div>
			<section class="scroll-reveal fade-up card p-6 md:p-8 mb-10"><h2 class="text-2xl md:text-3xl text-burgundy mb-4">SE בתוך טיפול אינטגרטיבי</h2><p class="text-base md:text-lg leading-relaxed mb-4">SE אינה מסלול שחייבים לבחור מראש. היא יכולה להשתלב לצד שיחה וקשר טיפולי, EMDR, עבודה עם התקשרות, דימויים או חומרי אמנות — בהתאם לצורך ולמוכנות.</p><p class="text-base md:text-lg leading-relaxed">המטרה אינה להכריח את הגוף להירגע, אלא לפתח היכרות טובה יותר עם תגובותיו ולמצוא בהדרגה יותר מרחב, ויסות ובחירה.</p></section>
			<div class="text-center"><a href={`https://wa.me/${siteData.whatsapp}`} class="btn-primary inline-flex" target="_blank" rel="noopener noreferrer">לשיחת היכרות</a><div><a href="/services" class="inline-flex mt-5 text-burgundy hover:underline">חזרה לטיפול הרגשי ←</a></div></div>
		</div></div>
	</section>
</Layout>
