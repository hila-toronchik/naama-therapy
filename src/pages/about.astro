---
import Layout from '../components/Layout.astro';
import { siteData } from '../content/site-data';
---

<Layout title="אודות נעמה טירן | מטפלת באמנות וב־EMDR" description="נעמה טירן, בעלת תואר שני בטיפול באמנות והכשרת EMDR. מידע על הגישה האינטגרטיבית, הניסיון הקליני והקליניקה ברמות השבים, ליד רעננה.">
	<section class="py-10 md:py-14 bg-cream-warm">
		<div class="container-custom">
			<div class="max-w-5xl mx-auto">
				<header class="scroll-reveal fade-up text-center mb-8 md:mb-12">
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-3 md:mb-4">
						{siteData.about.title}
					</h1>
					<div class="w-16 md:w-24 h-1 bg-burgundy mx-auto rounded-full"></div>
				</header>

				<!-- היכרות + הפילוסופיה הטיפולית + הניסיון הקליני -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-6 mb-5 md:mb-6 items-start">
					<section class="scroll-reveal scale-in w-full max-w-md mx-auto lg:max-w-none bg-white/80 rounded-2xl shadow-lg overflow-hidden">
						<div class="p-5 md:p-6">
							<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-4">
								{siteData.about.whoAmI.title}
							</h2>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								{siteData.about.whoAmI.text}
							</p>
						</div>
						<div>
							<img
								src="/images/naama.jpg"
								alt="נעמה טירן - מטפלת באמנות וב־EMDR"
								width="1066"
								height="1600"
								loading="eager"
								decoding="async"
								class="w-full h-auto lg:h-[310px] object-cover"
								style="object-position: center 35%;"
							/>
						</div>
					</section>

					<section class="scroll-reveal fade-up delay-100 card-sage p-5 md:p-7">
							<h2 class="text-xl md:text-2xl font-display text-burgundy mb-4">
								{siteData.about.philosophy.title}
							</h2>
							<div class="space-y-4 text-base md:text-lg text-charcoal leading-relaxed">
								{siteData.about.philosophy.paragraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
					</section>
				</div>

				<section class="scroll-reveal fade-up delay-200 card-sage p-5 md:p-7 mb-5 md:mb-6">
							<h2 class="text-xl md:text-2xl font-display text-burgundy mb-4">
								{siteData.about.clinicalExperience.title}
							</h2>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								{siteData.about.clinicalExperience.text}
							</p>
				</section>

				<!-- הכשרה אקדמית ומקצועית -->
				<section class="scroll-reveal fade-up card-sage p-5 md:p-7 mb-5 md:mb-6">
					<h2 class="text-xl md:text-2xl font-display text-burgundy mb-4">
						{siteData.about.education.title}
					</h2>
					<div class="space-y-3 md:space-y-4">
						{siteData.about.education.items.map((item) => (
							<div class="flex items-start gap-2 md:gap-3">
								<span class="text-burgundy text-lg md:text-xl mt-1 flex-shrink-0" aria-hidden="true">•</span>
								<p class="text-base md:text-lg text-charcoal leading-relaxed">{item}</p>
							</div>
						))}
					</div>
				</section>

				<!-- מיקום הטיפול -->
				<section class="scroll-reveal fade-up card-sage p-5 md:p-6 mb-5 md:mb-6">
					<h2 class="text-xl md:text-2xl font-display text-burgundy mb-4">מיקום הטיפול</h2>
					<div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-5 md:gap-7 items-center">
						<div class="order-2 md:order-1">
							<img
								src="/images/therapy-room.webp"
								alt="חדר הטיפול של נעמה טירן במושב רמות השבים"
								width="1125"
								height="1299"
								loading="lazy"
								decoding="async"
								class="w-full h-auto md:h-72 lg:h-80 rounded-lg shadow-md object-cover"
								style="object-position: center 55%;"
							/>
						</div>

						<div class="order-1 md:order-2">
							<p class="text-base md:text-lg text-charcoal leading-relaxed mb-4">
								הקליניקה ממוקמת במושב <strong>רמות השבים</strong>, ליד רעננה. יש חניה והקליניקה נגישה.
							</p>
							<div class="flex flex-col gap-2">
								<a href={siteData.location.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-burgundy hover:underline text-base md:text-lg transition-colors inline-flex items-center gap-2">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
									פתח ב־Google Maps
								</a>
								<a href={siteData.location.wazeUrl} target="_blank" rel="noopener noreferrer" class="text-burgundy hover:underline text-base md:text-lg transition-colors inline-flex items-center gap-2">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M11.436 2.127C6.27 2.127 2.073 6.324 2.073 11.49c0 2.485.973 4.745 2.558 6.426l-.717 2.25a.476.476 0 00.707.544l2.265-1.408c1.638.877 3.507 1.376 5.5 1.376 5.166 0 9.363-4.197 9.363-9.363 0-5.166-4.197-9.363-9.363-9.363m3.145 6.37c.39 0 .705.316.705.705 0 .39-.316.706-.705.706s-.706-.316-.706-.706.316-.705.706-.705m-6.29 0c.39 0 .706.316.706.705 0 .39-.316.706-.706.706s-.705-.316-.705-.706.316-.705.705-.705m8.583 5.07c-.744 1.807-2.558 3.07-4.67 3.07-2.112 0-3.926-1.263-4.67-3.07a.476.476 0 01.88-.364c.602 1.459 2.067 2.485 3.79 2.485s3.188-1.026 3.79-2.485a.476.476 0 01.88.364" />
									</svg>
									נווט ב־Waze
								</a>
							</div>
						</div>
					</div>
				</section>

				<!-- יצירת קשר -->
				<section class="scroll-reveal fade-up card-sage text-center p-5 md:p-7">
					<h2 class="text-2xl md:text-3xl font-display text-burgundy mb-3 md:mb-4">רוצה לבדוק התאמה?</h2>
					<p class="text-base md:text-lg text-charcoal mb-5 md:mb-6 max-w-2xl mx-auto leading-relaxed">
						אם עולה שאלה לגבי התאמה, אפשר לכתוב לי ולקבוע שיחת היכרות קצרה של 10–15 דקות, ללא עלות וללא התחייבות.
					</p>
					<div class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-3">
						<a href={`https://wa.me/${siteData.whatsapp}`} target="_blank" rel="noopener noreferrer" class="bg-burgundy text-white hover:opacity-90 inline-flex items-center gap-2 text-base md:text-lg px-6 py-3 rounded-lg transition-opacity">
							לתיאום שיחת היכרות ב־WhatsApp
						</a>
						<a href={siteData.instagram} target="_blank" rel="noopener noreferrer" class="border border-burgundy text-burgundy hover:bg-burgundy hover:text-white inline-flex items-center gap-2 text-base md:text-lg px-6 py-3 rounded-lg transition-colors">
							לתכנים נוספים באינסטגרם
						</a>
					</div>
					<a href="/services" class="inline-flex mt-5 text-burgundy hover:underline font-medium">לתחומי הטיפול ←</a>
				</section>
			</div>
		</div>
	</section>
</Layout>
