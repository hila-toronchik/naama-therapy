---
import { siteData } from '../content/site-data';
---

<section class="py-6 md:py-8 bg-cream-warm">
	<div class="container-custom">
		<div class="text-center mb-6 md:mb-8">
			<h2 class="text-2xl md:text-3xl font-display text-sage mb-3">
				מה אומרים המטופלים
			</h2>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
			{siteData.testimonials.map((testimonial, index) => (
				<div class={`card animate-stagger-${index + 1} p-4 md:p-5`}>
					<div class="mb-3">
						<svg class="w-6 h-6 md:w-8 md:h-8 text-burgundy" fill="currentColor" viewBox="0 0 24 24">
							<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.996 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.984zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
						</svg>
					</div>
					<p class="text-sm md:text-base text-charcoal mb-3 leading-relaxed italic">
						"{testimonial.text}"
					</p>
					<p class="text-burgundy font-semibold text-sm md:text-base">
						— {testimonial.author}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
