---
import Layout from '../components/Layout.astro';
import { siteData } from '../content/site-data';
import ArtTherapyGallery from '../components/ArtTherapyGallery.astro';
---

<Layout title="טיפול באמנות" description="מהו טיפול באמנות - ענף בפסיכותרפיה המשתמש ביצירה ככלי לביטוי ועיבוד רגשי">
	<section class="py-6 md:py-8 bg-cream-warm min-h-[85vh]">
		<div class="container-custom w-full">
			<div class="max-w-5xl mx-auto">
				<!-- Header -->
				<div class="text-center mb-8 md:mb-12">
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-burgundy mb-3 md:mb-4">
						מהו טיפול באמנות?
					</h1>
					<div class="w-16 md:w-24 h-1 bg-burgundy mx-auto rounded-full"></div>
				</div>

				<!-- מהו טיפול באמנות - ריבוע ראשי -->
				<div class="card-sage p-5 md:p-6 mb-6 md:mb-8">
					<p class="text-base md:text-lg text-charcoal leading-relaxed">
						טיפול באמנות הוא ענף בפסיכותרפיה המשתמש ביצירה ובחומרי אמנות ככלי לביטוי ועיבוד רגשי. הוא יכול להציע דרך נוספת לביטוי ולעיבוד, במיוחד כאשר קשה למצוא מילים מדויקות לחוויה.
					</p>
				</div>

				<!-- איך זה עובד -->
				<div class="card p-5 md:p-6 mb-6 md:mb-8">
					<h2 class="text-2xl md:text-3xl font-display text-charcoal mb-4 md:mb-5 font-bold">
						איך זה עובד?
					</h2>
					
					<div class="space-y-4 md:space-y-5">
						<div>
							<p class="text-base md:text-lg text-charcoal leading-relaxed mb-4">
								בתהליך הטיפולי היצירה יכולה לאפשר ביטוי לדברים שקשה עדיין לומר במילים. אפשר להתבונן בה, לדבר דרכה או פשוט להיות איתה, בלי צורך להבין מיד מה היא אומרת.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								מתן ביטוי מוחשי לרגש
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לעיתים אנחנו מנסים להבין את החוויה דרך הסברים הגיוניים, אך המילים אינן מצליחות לבטא את כולה. צבע, קו, צורה או חומר יכולים לפתוח ערוץ נוסף לביטוי ולאפשר מגע עם מה שעדיין קשה לומר, בלי לבטל את ההגנות ובלי לוותר על השיחה.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								התבוננות מהצד
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								כאשר רגש או חוויה מקבלים צורה מוחשית, לפעמים מתאפשר להתבונן בהם ממרחק מסוים. ההתבוננות המשותפת עשויה לעזור לזהות מה עולה, לתת לו מילים ולבחון בהדרגה את הקשר שלנו אליו.
							</p>
						</div>
					</div>
				</div>

			<!-- גלריית דוגמאות עבודה -->
			<div class="mb-3 md:mb-6">
				<ArtTherapyGallery />
			</div>

				<!-- למי הטיפול מיועד -->
				<div id="target-height-card" class="card-sage p-5 md:p-6 mb-6 md:mb-8">
					<h2 class="text-2xl md:text-3xl font-display text-charcoal mb-4 md:mb-5 font-bold">
						למי הטיפול מיועד?
					</h2>
					<p class="text-base md:text-lg text-charcoal leading-relaxed">
						טיפול באמנות עשוי להתאים למבוגרים שמרגישים שלפעמים המילים אינן מספיקות, או שרוצים לבחון דרך נוספת לביטוי ולהתבוננות. ניתן לשלב אותו בעבודה עם טראומה, חרדה, קשיי ויסות, משברי חיים והתמכרויות, בהתאם לצרכים ולהתאמה האישית. אין צורך בכישרון או בניסיון באמנות, משום שהדגש הוא על התהליך הרגשי ולא על התוצאה האסתטית.
					</p>
				</div>

				<!-- מה קורה בתוך חדר הטיפול -->
				<div class="card p-5 md:p-6 mb-6 md:mb-8">
					<h2 class="text-2xl md:text-3xl font-display text-charcoal mb-4 md:mb-5 font-bold">
						מה קורה בתוך חדר הטיפול?
					</h2>
					<p class="text-base md:text-lg text-charcoal leading-relaxed mb-6">
						החדר הוא מרחב של חופש שבו אין שיפוטיות, "נכון" או "לא נכון". כאן לא יוצרים אמנות כדי שתהיה יפה, אלא כדי שתהיה כנה.
					</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								1. הזמנה ליצירה
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								נתחיל בשיחה קצרה ולאחריה נבחר בחומרים שמרגישים נכונים באותו רגע – מצבעים רכים ועד חומרים בעלי נוכחות פיזית חזקה יותר.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								2. תהליך היצירה
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								במהלך היצירה אני נמצאת איתכם, קשובה למה שעולה ועוזרת לשמור על קצב שמתאים לכם. אפשר ליצור בשקט, לדבר תוך כדי, לעצור או לשנות כיוון, בהתאם למה שמרגיש נכון ובטוח באותו רגע.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								3. שיח והתבוננות
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לאחר היצירה נתבונן יחד במה שנוצר. לא ננסה "לפענח" את התוצאה, אלא ננסה להבין אילו רגשות ותובנות היא מעוררת בכם ואיך היא מתקשרת לחיים שלכם.
							</p>
						</div>
						
						<div class="bg-[#fbf3ea] rounded-xl shadow-md p-4 md:p-5 border border-charcoal/10">
							<h3 class="text-lg md:text-xl font-display text-charcoal mb-3 font-semibold">
								4. צידה לדרך
							</h3>
							<p class="text-base md:text-lg text-charcoal leading-relaxed">
								לפעמים היצירה מובילה לתובנה או לדרך מעשית לוויסות, ולפעמים היא משאירה שאלה שנמשיך לפגוש בהמשך. אין צורך להגיע לתוצאה מסוימת בכל פגישה.
							</p>
						</div>
					</div>
				</div>

				<!-- חזרה לתחומי טיפול -->
				<div class="text-center">
					<a
						href="/services"
						class="text-burgundy hover:text-burgundy/80 transition-colors font-medium inline-flex items-center gap-2"
					>
						← חזרה לתחומי טיפול
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
